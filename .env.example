# ── Devotional writing (Claude) ─────────────────────────────
# Without this, prayers come from the built-in offline composer.
ANTHROPIC_API_KEY=
# DEVOTIONAL_MODEL=claude-opus-5-5

# ── Image generation ────────────────────────────────────────
# Choose the active provider in /studio or config/providers.json.
# Only the key for the provider you use is needed.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
CUSTOM_IMAGE_API_KEY=

# ── Founder Style Studio (/studio) ──────────────────────────
# Any long random string. Studio is disabled when unset.
STUDIO_TOKEN=

# PORT=3000
# DATA_DIR=./data
